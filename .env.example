# --- Astrology computation ---------------------------------------------------
# Provider for kundali/birth-chart computation. "mock" (default) uses the built-in
# deterministic fake data; "prokerala" uses the real Swiss-Ephemeris API.
ASTROLOGY_PROVIDER=mock

# Ayanamsa (sidereal system). 1 = Lahiri (Indian govt. standard, recommended),
# 3 = Raman, 5 = KP. Leave unset for Lahiri.
# ASTROLOGY_AYANAMSA=1

# Prokerala v2 OAuth2 client-credentials.
# Get these at https://api.prokerala.com/ → set ASTROLOGY_PROVIDER=prokerala.
# Without both values the app automatically falls back to the mock.
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
# PROKERALA_BASE_URL=https://api.prokerala.com

# Geocoding (place of birth -> coordinates + timezone) uses Open-Meteo, which is
# free and keyless. No configuration required.
